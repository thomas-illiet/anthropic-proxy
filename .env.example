# Copy this file to .env and fill in your real values.

# OpenAI-compatible upstream endpoint.
ANTHROPIC_PROXY_UPSTREAM_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Your upstream API key.
ANTHROPIC_PROXY_UPSTREAM_API_KEY=replace-with-your-api-key

# The model you want the proxy to use.
ANTHROPIC_PROXY_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# Tool conversion mode:
# xml = Claude Adapter-style XML tool fallback for broad model compatibility.
# native = OpenAI-compatible function/tool calling passthrough.
ANTHROPIC_PROXY_TOOL_FORMAT=xml

# 1 = always replace any incoming Claude/Anthropic model with ANTHROPIC_PROXY_DEFAULT_MODEL.
# 0 = use ANTHROPIC_PROXY_MODEL_MAP / fallback logic instead.
ANTHROPIC_PROXY_FORCE_MODEL=1

# Optional mapping mode example when ANTHROPIC_PROXY_FORCE_MODEL=0:
# ANTHROPIC_PROXY_MODEL_MAP={"claude-opus":"meta/llama-3.1-70b-instruct","claude-sonnet":"meta/llama-3.1-8b-instruct","claude-haiku":"nvidia/llama-3.1-nemotron-nano-8b-v1"}

# Anthropic-visible model IDs returned by /v1/models and used for short
# aliases such as sonnet, opus, and haiku.
# ANTHROPIC_PROXY_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_PROXY_DEFAULT_OPUS_MODEL=claude-opus-4-8
# ANTHROPIC_PROXY_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# Proxy listen address.
ANTHROPIC_PROXY_LISTEN_ADDR=:8787

# Loaded once at startup. Restart the proxy after changing .env.
ANTHROPIC_PROXY_REQUEST_TIMEOUT_SEC=600

# Maximum accepted request body size.
ANTHROPIC_PROXY_MAX_REQUEST_BODY_BYTES=33554432

# Forward Anthropic cache_control metadata to compatible upstream gateways.
ANTHROPIC_PROXY_FORWARD_CACHE_CONTROL=0

# Logging level: trace, debug, info, warn, error, or off.
ANTHROPIC_PROXY_LOG_LEVEL=info

# Optional: require clients to send this key to your proxy.
# ANTHROPIC_PROXY_CLIENT_KEY=your-proxy-client-key
